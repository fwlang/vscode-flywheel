{
  "Function": {
    "prefix": [
      "fn",
      "function"
    ],
    "body": [
      "function ${1:name}(${2:int value}) returns ${3:int}",
      "    $0",
      "end"
    ],
    "description": "Declare a function with typed parameters"
  },
  "Zero-argument function": {
    "prefix": "fn0",
    "body": [
      "function ${1:main} returns ${2:void}",
      "    $0",
      "end"
    ],
    "description": "Declare a function without parameters"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} then",
      "    $0",
      "end"
    ],
    "description": "Conditional block"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} then",
      "    $2",
      "else",
      "    $0",
      "end"
    ],
    "description": "Conditional with alternative"
  },
  "For": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} do",
      "    $0",
      "end"
    ],
    "description": "Iterate a collection"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} do",
      "    $0",
      "end"
    ],
    "description": "While loop"
  },
  "When": {
    "prefix": "when",
    "body": [
      "when ${1:condition} do",
      "    $0",
      "end"
    ],
    "description": "Run the body each time a reactive condition becomes true"
  },
  "Reactive": {
    "prefix": "reactive",
    "body": [
      "reactive ${1:int} ${2:name} = ${3:0}"
    ],
    "description": "Declare a reactive variable"
  },
  "Computed": {
    "prefix": "computed",
    "body": [
      "computed ${1:bool} ${2:name} = ${3:expression}"
    ],
    "description": "Declare a value computed from reactive variables"
  },
  "Negated alias": {
    "prefix": "boolalias",
    "body": [
      "bool ${1:enabled}/${2:disabled} = ${3:true}"
    ],
    "description": "Declare a bool with a negated alias"
  },
  "Try / catch": {
    "prefix": "try",
    "body": [
      "try",
      "    $1",
      "catch ${2:Error} ${3:error}",
      "    $0",
      "end"
    ],
    "description": "Handle a typed error"
  },
  "Try / catch by name / then": {
    "prefix": "trythen",
    "body": [
      "try",
      "    $1",
      "catch \"${2:ValueError}\" ${3:error}",
      "    $4",
      "then",
      "    $0",
      "end"
    ],
    "description": "Catch an error by name; `then` runs on every exit (like finally)"
  },
  "Throw named error": {
    "prefix": "throw",
    "body": [
      "throw \"${1:MyError}\" with \"${2:message}\""
    ],
    "description": "Raise an error named by a string"
  },
  "Error type": {
    "prefix": "error",
    "body": [
      "error ${1:HttpFailure}(${2:int} ${3:status})"
    ],
    "description": "Declare an error type with fields and a message"
  },
  "Throw error type": {
    "prefix": "throwwith",
    "body": [
      "throw ${1:HttpFailure}(${2:503}) with \"${3:message}\""
    ],
    "description": "Throw a declared error type with a message"
  },
  "Assert": {
    "prefix": "assert",
    "body": [
      "assert ${1:condition} \"${2:message}\""
    ],
    "description": "Raise AssertionError with the message when the condition is false"
  },
  "JSON literal": {
    "prefix": "json",
    "body": [
      "<json>$0</json>"
    ],
    "description": "A json.value written as raw JSON"
  },
  "Native import": {
    "prefix": "importnative",
    "body": [
      "import ${1|cxx,c,rust,zig|} ${2:module}"
    ],
    "description": "Import functions from a C, C++, Rust, or Zig source file"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Person}",
      "    ${2:string} ${3:name}",
      "    $0",
      "end"
    ],
    "description": "Declare a class"
  },
  "Component": {
    "prefix": "component",
    "body": [
      "component ${1:Card} = <${2:div}>",
      "    {attr inner}",
      "    $0",
      "</$2>"
    ],
    "description": "Declare a markup component"
  },
  "Fragment": {
    "prefix": "fragment",
    "body": [
      "<>",
      "    $0",
      "</>"
    ],
    "description": "A fragment of markup nodes"
  },
  "Unit namespace": {
    "prefix": "unitns",
    "body": [
      "unitns ${1:time} for ${2:int, float}",
      "unit ${1}.${3:s} = 1",
      "unit ${1}.${4:min} = ${5:60}$0"
    ],
    "description": "Declare a unit namespace and its units"
  }
}
