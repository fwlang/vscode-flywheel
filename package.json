{
  "name": "flywheel-language",
  "displayName": "Flywheel",
  "icon": "icon.png",
  "description": "Syntax highlighting, snippets, and language server support (diagnostics, hover, navigation, rename, completion, formatting) for the Flywheel language.",
  "version": "0.1.0",
  "publisher": "fwlang",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "flywheel",
    "fw",
    "fly",
    "markup"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fwlang/flywheel.git",
    "directory": "fw-vscode"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:flywheel"
  ],
  "contributes": {
    "languages": [
      {
        "id": "flywheel",
        "aliases": [
          "Flywheel",
          "flywheel"
        ],
        "extensions": [
          ".fw",
          ".fly"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "flywheel",
        "scopeName": "source.flywheel",
        "path": "./syntaxes/flywheel.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.flywheel": "flywheel",
          "meta.embedded.block.css.flywheel": "css",
          "meta.embedded.block.javascript.flywheel": "javascript"
        }
      }
    ],
    "snippets": [
      {
        "language": "flywheel",
        "path": "./snippets/flywheel.json"
      }
    ],
    "configuration": {
      "title": "Flywheel",
      "properties": {
        "flywheel.path": {
          "type": "string",
          "default": "flywheel",
          "description": "Path to the flywheel compiler, which provides the language server (`flywheel lsp`)."
        },
        "flywheel.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the Flywheel language server for diagnostics, hover, go to definition, references, rename, completion, document symbols, and formatting."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "package": "vsce package --out flywheel-language.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
